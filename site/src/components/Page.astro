---
// Celá stránka v jednom jazyce (/ = en, /cs/ = cs). Obrázky se berou přímo z docs/ v repu.
import { Picture, getImage } from "astro:assets";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import interLatinExt from "@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url";
import appIcon from "../../../app-icon.png";
import heroDark from "../../../docs/screenshots/hero-dark.png";
import columns from "../../../docs/screenshots/columns.png";
import tabs from "../../../docs/screenshots/tabs.png";
import split from "../../../docs/screenshots/split-view.png";
import palette from "../../../docs/screenshots/command-palette.png";
import preview from "../../../docs/screenshots/previews.png";
import transparency from "../../../docs/screenshots/transparency.png";
import trash from "../../../docs/screenshots/recycle-bin.png";
import extensions from "../../../docs/screenshots/extensions.png";
import { texts, type Lang, type FeatureKey } from "../i18n/texts";
import { shortcuts } from "../lib/shortcuts";
import { links } from "../lib/links";
import { icon } from "../lib/icons";
import Hero from "./Hero.astro";
import LiveDemo from "./LiveDemo.astro";
import "../styles/site.css";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = texts[lang];

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = new URL(base, Astro.site);
const urls = { en: home.href, cs: new URL("cs/", home).href };
const canonical = urls[lang];
const asset = (p: string) => `${base}${p}`;

const poster = await getImage({ src: heroDark, width: 1280, format: "webp", quality: 80 });
const keys = shortcuts(lang);

// Karty funkcí: výřez skutečného screenshotu – zvětšení `zoom` kolem bodu `focus` (CSS transform-origin).
// wide = karta přes dva sloupce (bento).
type Card = { key: FeatureKey; img: ImageMetadata; ico: Parameters<typeof icon>[0]; focus: string; zoom: number; wide?: boolean };
// Ohniska podle polohy prvku ve snímku 1280×800 (paleta 350–930 × 95–410, menu přípon 480–1180 × 70–430 …).
const FEATURES: Card[] = [
  { key: "columns", img: columns, ico: "Columns3", focus: "62% 30%", zoom: 1.25, wide: true },
  { key: "palette", img: palette, ico: "Command", focus: "50% 30%", zoom: 1.9 },
  { key: "tabs", img: tabs, ico: "PanelTop", focus: "18% 12%", zoom: 2 },
  { key: "split", img: split, ico: "Columns2", focus: "56% 22%", zoom: 1.8 },
  { key: "preview", img: preview, ico: "Eye", focus: "68% 34%", zoom: 1.6 },
  { key: "transparency", img: transparency, ico: "Blend", focus: "50% 40%", zoom: 1.5 },
  { key: "trash", img: trash, ico: "Trash2", focus: "18% 20%", zoom: 1.8 },
  { key: "extensions", img: extensions, ico: "FileType", focus: "66% 30%", zoom: 1.35 },
];
const cardSizes = (c: Card) => {
  const w = c.wide ? 720 : 360;
  return `(min-width: 1120px) ${Math.round(w * c.zoom)}px, (min-width: 760px) ${Math.round((c.wide ? 66 : 50) * c.zoom)}vw, ${Math.round(100 * c.zoom)}vw`;
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="cs" href={urls.cs} />
    <link rel="alternate" hreflang="x-default" href={urls.en} />
    <link rel="icon" href={asset("favicon.ico")} sizes="any" />
    <link rel="icon" href={asset("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <link rel="sitemap" href={asset("sitemap-index.xml")} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {/* Čeština: malá podmnožina s č, ř, ž … (scripts/prepare.mjs) – bez ní by se čekalo na celé latin-ext. */}
    {lang === "cs" && <link rel="preload" href={asset("fonts/inter-cs.woff2")} as="font" type="font/woff2" crossorigin />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dirwise" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={lang === "en" ? texts.cs.ogLocale : texts.en.ogLocale} />
    <meta property="og:image" content={new URL("og.png", home).href} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={new URL("og.png", home).href} />

    <style set:html={`
      @font-face { font-family: "Inter Variable"; font-style: normal; font-display: swap; font-weight: 100 900;
        src: url(${interLatinExt}) format("woff2-variations");
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
      @font-face { font-family: "Inter Variable"; font-style: normal; font-display: swap; font-weight: 100 900;
        src: url(${interLatin}) format("woff2-variations");
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
      @font-face { font-family: "Inter Variable"; font-style: normal; font-display: swap; font-weight: 100 900;
        src: url(${asset("fonts/inter-cs.woff2")}) format("woff2-variations");
        unicode-range: U+010C-010F,U+011A-011B,U+0147-0148,U+0158-0159,U+0160-0161,U+0164-0165,U+016E-016F,U+017D-017E; }
    `} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Dirwise",
      description: t.description,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Windows 10, Windows 11",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      url: canonical,
      downloadUrl: links.latest,
      license: "https://opensource.org/licenses/MIT",
    })} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="page-lines" aria-hidden="true"></div>
    <Hero lang={lang} base={base} />

    <main id="main">
      <section class="live" aria-label={t.liveLabel}>
        <LiveDemo lang={lang} />
      </section>

      <section class="block" id="features" aria-labelledby="features-title">
        <header class="block-head">
          <p class="eyebrow">{t.featuresEyebrow}</p>
          <h2 id="features-title">{t.featuresTitle}</h2>
          <p class="section-lead">{t.featuresLead}</p>
        </header>
        <div class="bento">
          {FEATURES.map((c) => (
            <article class:list={["card", { "card-wide": c.wide }]}>
              <div class="card-head">
                <span class="card-icon" set:html={icon(c.ico, 18)} />
                <h3>{t.features[c.key].title}</h3>
              </div>
              <p>{t.features[c.key].text}</p>
              <div class="card-shot">
                <Picture src={c.img} widths={[480, 800, 1280]} sizes={cardSizes(c)} formats={["avif", "webp"]}
                  fallbackFormat="jpg" quality={78} alt={t.features[c.key].alt} loading="lazy" decoding="async"
                  style={`object-position: ${c.focus}; transform-origin: ${c.focus}; transform: scale(${c.zoom})`} />
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="block video" aria-labelledby="video-title">
        <header class="block-head">
          <p class="eyebrow">{t.videoEyebrow}</p>
          <h2 id="video-title">{t.videoTitle}</h2>
        </header>
        <div class="frame">
          <!-- Bez JS jsou vidět ovládací prvky; JS je skryje, video spustí až na obrazovce a přidá tlačítko pauzy. -->
          <video id="demo-video" width="1440" height="900" muted loop playsinline controls preload="none"
            data-poster={poster.src} aria-label={t.videoLabel} src={asset("media/dirwise-demo.mp4")}></video>
          <button type="button" class="vtoggle" id="demo-toggle" hidden data-play={t.play} data-pause={t.pause} aria-label={t.pause}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-pause"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-play"><path fill="currentColor" d="M8 5.5v13l10.5-6.5z"/></svg>
          </button>
        </div>
      </section>

      <section class="block shortcuts" aria-labelledby="shortcuts-title">
        <header class="block-head">
          <p class="eyebrow">{t.shortcutsEyebrow}</p>
          <h2 id="shortcuts-title">{t.shortcutsTitle}</h2>
          <p class="section-lead">{t.shortcutsLead}</p>
        </header>
        <ul class="keys">
          {keys.main.map(([k, a]) => (
            <li><span class="keycaps" set:html={k} /><span class="key-action" set:html={a} /></li>
          ))}
        </ul>
        <details class="all-keys">
          <summary>{t.allShortcuts}</summary>
          <table>
            <thead><tr><th scope="col">{t.shortcutKey}</th><th scope="col">{t.shortcutAction}</th></tr></thead>
            <tbody>
              {keys.all.map(([k, a]) => <tr><td set:html={k} /><td set:html={a} /></tr>)}
            </tbody>
          </table>
        </details>
      </section>

      <section class="block faq" id="faq" aria-labelledby="faq-title">
        <header class="block-head">
          <p class="eyebrow">{t.faqEyebrow}</p>
          <h2 id="faq-title">{t.faqTitle}</h2>
        </header>
        <div class="faq-list">
          {t.faq.map((f, i) => (
            <details name="faq" open={i === 0}>
              <summary>{f.q}<span class="faq-plus" aria-hidden="true" /></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer class="foot">
      <nav aria-label={t.footerNav}>
        <a href={links.repo}>{t.footer.github}</a>
        <a href={links.changelog}>{t.footer.changelog}</a>
        <a href={links.privacy}>{t.footer.privacy}</a>
        <a href={links.issues}>{t.footer.issues}</a>
      </nav>
      <p>© 2026 krystof2-ops · <a href={links.license}>{t.footerNote}</a></p>
    </footer>

    <script>
      // Video (preload="none") se spustí, až je na obrazovce, a mimo ni se pozastaví.
      // Tlačítko pauzy (WCAG 2.2.2); s „omezit pohyb“ se samo nespouští – zůstanou nativní ovládací prvky.
      const video = document.getElementById("demo-video") as HTMLVideoElement | null;
      const toggle = document.getElementById("demo-toggle") as HTMLButtonElement | null;
      // Poster (56 kB) až kousek před videem – nesoupeří s písmem a hero o první vykreslení.
      if (video?.dataset.poster) {
        const setPoster = () => { video.poster = video.dataset.poster!; };
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver((e) => {
            if (e.some((x) => x.isIntersecting)) { io.disconnect(); setPoster(); }
          }, { rootMargin: "800px" });
          io.observe(video);
        } else setPoster();
      }
      if (video && toggle && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let paused = false; // pozastaveno uživatelem
        const sync = () => {
          const playing = !video.paused;
          toggle.classList.toggle("is-paused", !playing);
          toggle.setAttribute("aria-label", playing ? toggle.dataset.pause! : toggle.dataset.play!);
        };
        const play = () => video.play().catch(() => { video.controls = true; toggle.hidden = true; });
        video.controls = false;
        toggle.hidden = false;
        video.addEventListener("play", sync);
        video.addEventListener("pause", sync);
        toggle.addEventListener("click", () => {
          paused = !video.paused;
          if (paused) video.pause(); else play();
        });
        if ("IntersectionObserver" in window) {
          new IntersectionObserver((entries) => {
            const visible = entries.some((e) => e.isIntersecting);
            if (visible && !paused) play();
            else if (!visible) video.pause();
          }, { rootMargin: "200px" }).observe(video);
        } else play();
      }

      for (const btn of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
        const text = btn.querySelector("span") ?? btn;
        const label = text.textContent;
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy!);
            text.textContent = btn.dataset.done!;
            setTimeout(() => { text.textContent = label; }, 1600);
          } catch { /* schránka nedostupná (http, oprávnění) – nic */ }
        });
      }
    </script>
  </body>
</html>
